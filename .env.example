# ---------------------------------------------------------------------------
# Upgrade Planner - every environment variable the application reads.
#
# Copy what you need; nothing here is secret, because the application has no
# secrets. It has no accounts, no API keys, and no external services. If that
# ever changes, a real value must never be committed to this file.
# ---------------------------------------------------------------------------

# === API (server/UpgradePlanner.Api) =======================================
# Read through ASP.NET Core configuration, so each may also be supplied as a
# command line argument or in appsettings.json.

# Turns on the public-demo behaviour: the app seeds generated fixture data into
# an empty database at startup, and the "--reset-demo-data" flag is unlocked.
#
# Accepted: true / 1 / yes / on, and false / 0 / no / off.
# Anything else is treated as FALSE and logs a warning - a typo must never
# enable the mode that writes data.
#
# Demo mode ALWAYS uses its own database file (demo.db) and ignores
# ConnectionStrings__Default entirely. That is a deliberate barrier: no
# environment variable can point a demo seed at the real database.
DEMO_MODE=false

# SQLite connection string. Ignored when DEMO_MODE is on.
# Default: "Data Source=upgradeplanner.db"
ConnectionStrings__Default=Data Source=upgradeplanner.db

# Comma-separated browser origins allowed to call the API cross-origin.
# Must be absolute http(s) origins; a trailing slash is normalised away, and an
# unparseable entry is dropped with a warning rather than crashing startup.
# Default: http://localhost:5176 (the Vite dev server)
#
# NOTE: this is a browser control, not an access control. The API has no
# authentication, so restricting origins does not stop a direct request. See
# docs/SECURITY.md.
ALLOWED_ORIGINS=http://localhost:5176

# Port to bind. Set automatically by most PaaS hosts; leave unset locally.
# PORT=8080

# Commit the running build came from, surfaced at GET /health.
# Default: "unknown"
# BUILD_SHA=

# Standard ASP.NET Core switch. "Development" additionally enables the OpenAPI
# endpoint, HTTPS redirection, and exception detail in error responses.
ASPNETCORE_ENVIRONMENT=Development


# === Client (client/) ======================================================
# Vite only exposes variables prefixed with VITE_ to browser code.
#
# ****  ANY VALUE PREFIXED VITE_ IS COMPILED INTO THE PUBLIC BUNDLE.  ****
# ****  It is world-readable. Never put a credential behind that prefix. ****
#
# These belong in client/.env.local (gitignored) or in the CI build step.

# Origin the API lives on. Leave EMPTY for local development: the Vite dev
# server proxies /api to localhost:5131, which keeps the app same-origin and
# takes CORS out of the picture entirely.
VITE_API_BASE_URL=

# Shows the "public demo" banner. Same accepted spellings as DEMO_MODE, same
# conservative fallback to false.
VITE_DEMO_MODE=false

# Path the app is served from. A GitHub Pages *project* site lives under
# /<repo>/, so the deploy workflow sets this to /upgrade-planner/. This single
# value feeds both Vite's asset URLs and the router's basename.
# Default: /
VITE_BASE_PATH=/

# Short commit sha, shown in the page footer so a deployed page can be tied
# back to a commit. Default: "dev"
VITE_BUILD_SHA=
