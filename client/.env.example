# Vite reads .env files from this directory. Copy to .env.local (gitignored) to
# override locally. The full list of variables for both halves of the app,
# including the API's, is documented in ../.env.example.
#
# ****  ANY VALUE PREFIXED VITE_ IS COMPILED INTO THE PUBLIC BUNDLE.  ****
# ****  It is world-readable. Never put a credential behind that prefix. ****

# Origin the API lives on. Leave EMPTY locally: the dev server proxies /api to
# localhost:5131, so the app is same-origin and CORS never comes into play.
VITE_API_BASE_URL=

# Shows the "public demo" banner. true / 1 / yes / on; anything else is false.
VITE_DEMO_MODE=false

# Path the app is served from, e.g. /upgrade-planner/ for a GitHub Pages project
# site. Feeds both Vite's asset URLs and the router basename.
VITE_BASE_PATH=/

# Short commit sha shown in the footer.
VITE_BUILD_SHA=
